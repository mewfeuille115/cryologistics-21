{
  "Outbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 50
  },
  "Inbox": {
    "IntervalInSeconds": 5,
    "BatchSize": 50
  },
  "ConnectionStrings": {
    "users-db": "Host=cryologistics21.database;Port=5432;Database=cryologistics21;Username=postgres;Password=postgres;Include Error Detail=true",
    "Cache": "cryologistics21.redis:6379",
    "Queue": "cryologistics21.kafka:9092",
    "Seq": "http://cryologistics21.seq:5341"
  },
  "Authentication": {
    "Audience": "cryologistics-21",
    "TokenValidationParameters": {
      "ValidIssuers": [
        "https://localhost:18080/realms/cryologistics21"
      ]
    },
    "MetadataAddress": "http://localhost:18080/realms/cryologistics21/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "http://cryologistics21.identity:9000/health/"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Cryologistics21.Services.Users.Infrastructure.Outbox": "Warning",
        "Cryologistics21.Services.Users.Infrastructure.Inbox": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://cryologistics21.seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Cryologistics21.Services.Users.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://cryologistics21.jaeger:4317"
}
