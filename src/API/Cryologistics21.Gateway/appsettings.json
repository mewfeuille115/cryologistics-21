{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Cryologistics21.Gateway"
    }
  },
  "Authentication": {
    "Audience": "",
    "TokenValidationParameters": {
      "ValidIssuers": []
    },
    "MetadataAddress": "",
    "RequireHttpsMetadata": false
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "users-register-route": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/users/register"
        }
      },
      "users-login-route": {
        "ClusterId": "users-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/users/login"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-api": {
            "Address": "http://users-api"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
