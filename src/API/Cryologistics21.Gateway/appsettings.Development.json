{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Audience": "cryologistics-21",
    "TokenValidationParameters": {
      "ValidIssuers": [
        "https://localhost:18080/realms/cryologistics21"
      ]
    },
    "MetadataAddress": "https://localhost:18080/realms/cryologistics21/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://cryologistics21.seq:5341" }
      }
    ]
  }
}
