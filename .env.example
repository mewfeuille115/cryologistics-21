# Copy this file to ".env" (same folder, repo root) and replace every value.
# ".env" must stay out of git. Never commit real secrets.

# Client secret of the "cryologistics-21" client (used by the API to log users in)
CRYOLOGISTICS21_API_CLIENT_SECRET=change-me

# Client secret of the "cryologistics-21-admin" client (service account used by the API to manage users)
CRYOLOGISTICS21_ADMIN_CLIENT_SECRET=change-me

# Passwords for the demo users created when the realm is imported
DEMO_ADMIN_PASSWORD=change-me
DEMO_OPERATOR_PASSWORD=change-me
DEMO_QA_PASSWORD=change-me
